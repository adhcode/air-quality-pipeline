{
  "name": "air-quality-pipeline",
  "version": "0.1.0",
  "description": "ETL pipeline + API for air quality and environmental risk data",
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "verify": "tsx scripts/verify-ingestion.ts",
    "ingest": "tsx src/ingestion/run-ingestion.ts",
    "process": "tsx src/processing/run-processing.ts",
    "load:warehouse": "tsx warehouse/load-to-bigquery.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.0",
    "@prisma/client": "^5.19.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "prisma": "^5.19.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
