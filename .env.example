# Copy this file to .env and fill in real values

# Postgres connection string used by Prisma
DATABASE_URL="postgresql://aq_user:aq_password@localhost:5434/air_quality?schema=public"

# OpenAQ API (v3 requires a free API key: https://explore.openaq.org/register)
OPENAQ_API_KEY=""

# Comma-separated OpenAQ location IDs to track (fill in after running the locations lookup)
TRACKED_LOCATION_IDS=""

# AirQo API (Africa-focused, covers Lagos and other African cities)
# Get a free token: https://analytics.airqo.net/user/login -> Account Settings -> API
AIRQO_API_TOKEN=""

# Comma-separated AirQo grid IDs to track (look these up via AirQo's
# /v2/devices/grids endpoint, or their analytics dashboard, for Lagos/Nigeria)
TRACKED_AIRQO_GRID_IDS=""

# Port for the Express API
PORT=3000

# Path to a Google Cloud service account JSON key with BigQuery Data Editor
# + Job User roles, used by warehouse/load-to-bigquery.ts
GOOGLE_APPLICATION_CREDENTIALS=""
